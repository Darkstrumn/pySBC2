[
  {
    "id": "tab_sbc_events",
    "type": "tab",
    "label": "SBC Host Bridge",
    "disabled": false,
    "info": "Customize the controller-to-host routing and host-to-controller feedback independently. No HID output is produced inside this flow."
  },
  {
    "id": "sbc_controller_events",
    "type": "mqtt in",
    "z": "tab_sbc_events",
    "name": "Controller events",
    "x": 140,
    "y": 80,
    "wires": [
      [
        "sbc_to_host"
      ]
    ],
    "topic": "sbc/events/#",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_local",
    "rap": false,
    "rh": 0
  },
  {
    "id": "sbc_to_host",
    "type": "function",
    "z": "tab_sbc_events",
    "name": "Route game-host output",
    "x": 400,
    "y": 80,
    "wires": [
      [
        "sbc_host_out"
      ]
    ],
    "outputs": 1,
    "func": "const allowed = [\"meta\", \"button\", \"raw_state\", \"macro_key\", \"aux_input\", \"vessel_snapshot\"];\nconst type = msg.topic.split(\"/\").pop();\nif (!allowed.includes(type)) return null;\nmsg.topic = \"sbc/host/control/\" + type;\nmsg.retain = type === \"meta\";\nreturn msg;"
  },
  {
    "id": "sbc_host_out",
    "type": "mqtt out",
    "z": "tab_sbc_events",
    "name": "Host and HID subscribers",
    "x": 690,
    "y": 80,
    "wires": [],
    "topic": "",
    "qos": "",
    "retain": "",
    "broker": "mqtt_broker_local"
  },
  {
    "id": "sbc_host_feedback",
    "type": "mqtt in",
    "z": "tab_sbc_events",
    "name": "Host feedback",
    "x": 140,
    "y": 180,
    "wires": [
      [
        "sbc_to_controller"
      ]
    ],
    "topic": "sbc/host/feedback",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_local",
    "rap": false,
    "rh": 0
  },
  {
    "id": "sbc_to_controller",
    "type": "function",
    "z": "tab_sbc_events",
    "name": "Validate and route feedback",
    "x": 400,
    "y": 180,
    "wires": [
      [
        "sbc_command_out"
      ]
    ],
    "outputs": 1,
    "func": "if (msg.retain) return null;\nconst request = msg.payload;\nif (!request || ![\"button\", \"macro\", \"led\", \"event\"].includes(request.command)) return null;\nconst body = request.payload;\nif (!body || typeof body !== \"object\" || Array.isArray(body)) return null;\nmsg.topic = \"sbc/cmd/\" + request.command;\nmsg.payload = body;\nmsg.retain = false;\nreturn msg;"
  },
  {
    "id": "sbc_command_out",
    "type": "mqtt out",
    "z": "tab_sbc_events",
    "name": "Controller commands",
    "x": 690,
    "y": 180,
    "wires": [],
    "topic": "",
    "qos": "",
    "retain": "false",
    "broker": "mqtt_broker_local"
  },
  {
    "id": "mqtt_broker_local",
    "type": "mqtt-broker",
    "name": "Local MQTT",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "sessionExpiry": ""
  }
]
