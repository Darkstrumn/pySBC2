  {
    "id": "fn_button_to_led",
    "type": "function",
    "z": "tab_sbc_events",
    "name": "Start->LED Momentary",
    "func": "const ev = msg.payload || {};\nif (ev.control !== \"Start\") {\n    return null;\n}\nmsg.topic = \"sbc/cmd/led\";\nmsg.payload = {\n    led: \"Start\",\n    mode: ev.pressed ? \"steady\" : \"off\",\n    intensity: 15\n};\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 80,
    "wires": [
      [
        "mqtt_out_cmd_led",
        "debug_led_cmd"
      ]
    ]
  },
  {
