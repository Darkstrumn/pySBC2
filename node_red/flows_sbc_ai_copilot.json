  {
    "id": "fn_diag_to_led",
    "type": "function",
    "z": "tab_sbc_ai_copilot",
    "name": "Diagnostic->LED",
    "func": "const p = msg.payload || {};\nif (p.severity !== \"critical\" && p.severity !== \"warning\") {\n  return null;\n}\nmsg.topic = \"sbc/cmd/led\";\nmsg.payload = {\n  led: p.severity === \"critical\" ? \"Eject\" : \"Start\",\n  mode: \"blink\",\n  period_ms: p.severity === \"critical\" ? 220 : 500,\n  on_ms: p.severity === \"critical\" ? 120 : 250,\n  intensity: 15,\n  duration_ms: 1500,\n  source: \"nodered_ai_diag\"\n};\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 340,
    "wires": [
      [
        "mqtt_out_cmd_led_from_diag",
        "debug_ai_diag_led"
      ]
    ]
  },
