  {
    "id": "fn_intent_gate_macro",
    "type": "function",
    "z": "tab_sbc_ai_copilot",
    "name": "Gate Intent->Macro",
    "func": "const p = msg.payload || {};\nconst confidence = Number(p.confidence || 0);\nif (!p.recommended_macro) {\n  return null;\n}\nif (confidence < 0.90) {\n  return null;\n}\nmsg.topic = \"sbc/cmd/macro\";\nmsg.payload = {\n  macro: p.recommended_macro,\n  source: \"nodered_ai_gate\",\n  intent: p.intent,\n  confidence\n};\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 260,
    "wires": [
      [
        "mqtt_out_cmd_macro_from_ai",
        "debug_ai_macro_gate"
      ]
    ]
  },
